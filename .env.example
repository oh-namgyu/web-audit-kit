HOST=127.0.0.1
PORT=6197

# Legacy TESTGPT7_* names are still read as a deprecated fallback.

# web-audit-kit is local-only by default. Set this only on a trusted network
# with separate authentication, allowlists, and rate limits.
WEB_AUDIT_KIT_ALLOW_NETWORK_EXPOSURE=false
WEB_AUDIT_KIT_TARGET_ALLOWLIST=
WEB_AUDIT_KIT_ALLOW_ANY_TARGET=false
WEB_AUDIT_KIT_BLOCK_PRIVATE_IPS=false
WEB_AUDIT_KIT_ALLOW_PRIVATE_TARGETS=false
WEB_AUDIT_KIT_MAX_REDIRECTS=5

# Optional Playwright module fallback. Normally leave blank and use npm install.
WEB_AUDIT_KIT_PLAYWRIGHT_PATH=

# Mail delivery is opt-in.
# Supported: disabled, sendmail, smtp
WEB_AUDIT_KIT_MAIL_TRANSPORT=disabled
WEB_AUDIT_KIT_MAIL_FROM=web-audit-kit-audit@localhost

# Sendmail
WEB_AUDIT_KIT_SENDMAIL_PATH=/usr/sbin/sendmail

# SMTP
WEB_AUDIT_KIT_SMTP_HOST=
WEB_AUDIT_KIT_SMTP_PORT=587
WEB_AUDIT_KIT_SMTP_SECURE=false
WEB_AUDIT_KIT_SMTP_USER=
WEB_AUDIT_KIT_SMTP_PASS=
