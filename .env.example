HOST=127.0.0.1
PORT=6197

# testGpt7 is local-only by default. Set this only on a trusted network
# with separate authentication, allowlists, and rate limits.
TESTGPT7_ALLOW_NETWORK_EXPOSURE=false
TESTGPT7_TARGET_ALLOWLIST=
TESTGPT7_ALLOW_ANY_TARGET=false
TESTGPT7_BLOCK_PRIVATE_IPS=false
TESTGPT7_ALLOW_PRIVATE_TARGETS=false
TESTGPT7_MAX_REDIRECTS=5

# Optional Playwright module fallback. Normally leave blank and use npm install.
TESTGPT7_PLAYWRIGHT_PATH=

# Mail delivery is opt-in.
# Supported: disabled, sendmail, smtp
TESTGPT7_MAIL_TRANSPORT=disabled
TESTGPT7_MAIL_FROM=testgpt7-audit@localhost

# Sendmail
TESTGPT7_SENDMAIL_PATH=/usr/sbin/sendmail

# SMTP
TESTGPT7_SMTP_HOST=
TESTGPT7_SMTP_PORT=587
TESTGPT7_SMTP_SECURE=false
TESTGPT7_SMTP_USER=
TESTGPT7_SMTP_PASS=
